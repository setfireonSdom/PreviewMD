# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ── PyInstaller ──
build/
dist/
*.spec
!PreviewMD.spec

# ── Virtual environments ──
.venv/
venv/
env/
*.env

# Lock files from alternative installers. The project installs with pip from
# requirements.txt (README, CI, and build.sh all agree on that), so a stray
# uv.lock or poetry.lock is a local artefact, not a source of truth.
uv.lock
poetry.lock
Pipfile.lock

# ── macOS ──
.DS_Store
.AppleDouble
.LSOverride
._*

# ── IDE / editors ──
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig

# ── Tool caches ──
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Logs ──
logs/
*.log

# ── Local AI helper notes (kept out of the repository) ──
AGENTS.md
